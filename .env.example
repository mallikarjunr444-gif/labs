# ============================================================================
# MEDICUS LABS™ - ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env and fill in your actual values
# ============================================================================

# ============================================================================
# FRONTEND CONFIGURATION (.env in /frontend folder)
# ============================================================================
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================================
# BACKEND CONFIGURATION (.env in root folder)
# ============================================================================
# FastAPI Settings
ENVIRONMENT=development
DEBUG=true
API_TITLE=Medicus Labs API
API_VERSION=1.0.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=sqlite:///./medicus.db

# For PostgreSQL (Supabase):
# DATABASE_URL=postgresql://user:password@localhost/medicusdb

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_api_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ============================================================================
# AI/ML CONFIGURATION
# ============================================================================
# HuggingFace
HUGGING_FACE_API_KEY=hf_your_api_key_here
HF_MODEL_NAME=microsoft/resnet-50
HF_MODEL_URL=https://api-inference.huggingface.co/models/

# ISIC Archive API
ISIC_API_BASE_URL=https://api.isic-archive.com/api/v2
ISIC_API_KEY=optional_if_isic_requires_auth

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@medicuslabs.com
SENDER_NAME=Medicus Labs

# ============================================================================
# JWT/SECURITY CONFIGURATION
# ============================================================================
SECRET_KEY=your_super_secret_key_change_this_in_production_12345678
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================================
# FILE STORAGE
# ============================================================================
# Local storage or S3/Supabase
STORAGE_TYPE=local  # or 'supabase'
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=medicus.log

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================
# Vercel Frontend
VERCEL_FRONTEND_URL=https://your-app.vercel.app

# Railway/Render Backend
RENDER_BACKEND_URL=https://your-api.onrender.com

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600  # seconds

# ============================================================================
# STRIPE (Optional - for future payment features)
# ============================================================================
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
