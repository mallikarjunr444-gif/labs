{
  "name": "labs",
  "compatibility_date": "2026-07-20",
  "main": "./src/index.js",

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
